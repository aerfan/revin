# Copy to .env.local for local builds. On Vercel, set these in Project Settings → Environment Variables.
# Supabase → Project Settings → API (or Data API): Project URL and the anon / publishable key. Both are safe to ship to browsers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: shown on the sign-in screen.
AGENCY_NAME=
